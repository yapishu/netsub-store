# Copy to .env, then fill every required value. Keep .env private (chmod 600).
PUBLIC_ORIGIN=https://planets.example.com
PORT=8080
STAR=~yourstar
# Set exactly one: raw private key OR BIP39 word phrase for the owner/spawn proxy.
# A management-only proxy cannot spawn, regardless of input format.
SPAWN_PRIVATE_KEY=
SPAWN_MNEMONIC=
# Optional BIP39 passphrase used when that proxy wallet is generated.
SPAWN_MNEMONIC_PASSPHRASE=
# Generate using: go run ./cmd/store encryption-key
DATA_ENCRYPTION_KEY=
# Public EVM address permitted to sign into /admin.
ADMIN_WALLET_ADDRESS=
SENDGRID_API_KEY=
EMAIL_FROM=planets@example.com
# Payment receipts only; planet credentials go exclusively to the buyer.
RECEIPT_EMAIL=matwet@subject.network
WALLETCONNECT_PROJECT_ID=
# Optional RPC endpoints; leave empty to use Etherscan.
ETH_RPC_URL=
BASE_RPC_URL=
# Confirmation depth for RPC and Etherscan; includes the transaction block.
ETH_CONFIRMATIONS=20
BASE_CONFIRMATIONS=180
# One Etherscan V2 key covers Ethereum and Base, subject to plan availability.
ETHERSCAN_API_KEY=
# Native local execution uses this directory; Compose sets /gonetia.
GONETIA_DIR=data/gonetia
DEMO=false

# Optional on-chain Bitcoin. Leave RPC URL empty to hide BTC checkout.
# Base node URL, without /wallet/. Compose must be able to reach this LAN address.
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
# Loaded Bitcoin Core wallet with an active receiving descriptor/keypool.
# A watch-only descriptor wallet is sufficient; the store never spends coins.
BITCOIN_RPC_WALLET=netsub-store
BITCOIN_NETWORK=main
BITCOIN_CONFIRMATIONS=6

# Optional Monero: a view-only monero-wallet-rpc connected to the same daemon.
# Base URLs, without /json_rpc. An empty wallet URL disables Monero.
MONERO_WALLET_RPC_URL=
MONERO_WALLET_RPC_USER=
MONERO_WALLET_RPC_PASSWORD=
MONERO_DAEMON_RPC_URL=
# Daemon credentials are optional when its restricted RPC has no login.
MONERO_DAEMON_RPC_USER=
MONERO_DAEMON_RPC_PASSWORD=
MONERO_NETWORK=mainnet
MONERO_ACCOUNT_INDEX=0
MONERO_CONFIRMATIONS=10

# Optional NOCK. Native receiving uses a dedicated V1 public branch; never a zprv.
NOCKCHAIN_ZPUB=
NOCKCHAIN_CONFIRMATIONS=2
# Base token transfers use the configured EVM payment recipient.
BASE_NOCK_ENABLED=false
# Required for either NOCK payment method (quotes and native indexing).
NOCKBLOCKS_API_KEY=
NOCKBLOCKS_RPC_V1_URL=https://nockblocks.com/rpc/v1
NOCKBLOCKS_RPC_URL=https://nockblocks.com/rpc

# Optional CoinGecko Demo API key; empty uses the keyless public endpoint.
COINGECKO_DEMO_API_KEY=
